{
  "name": "ptt-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production backend for the PTT (push-to-talk) app: Fastify + Prisma + Redis + LiveKit.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "db:sqlite:migrate": "prisma migrate dev --schema prisma/sqlite/schema.prisma",
    "db:sqlite:seed": "SQLITE_DATABASE_URL=file:./dev.db prisma db seed --schema prisma/sqlite/schema.prisma",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down -v",
    "verify": "npm run typecheck && npm run test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/s3-request-presigner": "^3.712.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.1",
    "@otplib/preset-default": "^12.0.1",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "expo-server-sdk": "^3.15.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.1",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
