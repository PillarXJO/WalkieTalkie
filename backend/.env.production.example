# ------------------------------------------------------------------
# PTT backend - PRODUCTION environment
#
# Copy to `.env` on the server:  cp .env.production.example .env
# Then replace every CHANGE_ME / example.com value. Never commit `.env`.
#
# Run with:  docker compose -f docker-compose.prod.yml up -d --build
# The compose file reads DOMAIN, POSTGRES_* and everything below from here.
# ------------------------------------------------------------------

# --- Host domain (used by Caddy for HTTPS + the app URL) -----------
DOMAIN=api.example.com

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
APP_VERSION=0.1.0

# --- Data stores ---------------------------------------------------
POSTGRES_USER=ptt
POSTGRES_PASSWORD=CHANGE_ME_long_random_db_password
POSTGRES_DB=ptt
DATABASE_URL=postgresql://ptt:CHANGE_ME_long_random_db_password@postgres:5432/ptt
DATABASE_PROVIDER=postgresql
REDIS_URL=redis://redis:6379

# --- CORS (production forbids wildcard; list real origins) ---------
CORS_ORIGINS=https://api.example.com
ALLOW_INSECURE_CORS=false

# --- Auth secrets (REQUIRED: must NOT start with "dev-only") -------
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_long_random_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_long_random_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=4320
SCRYPT_COST=16384
TOTP_ISSUER=PTT

# --- Deep links / invites ------------------------------------------
DEEP_LINK_SCHEME=ptt
UNIVERSAL_LINK_HOST=api.example.com
WEB_BASE_URL=https://api.example.com
INVITE_BASE_URL=https://api.example.com

# --- LiveKit (WebRTC). Not used by the current app; leave disabled  -
LIVEKIT_ENABLED=false
LIVEKIT_URL=wss://api.example.com
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# --- Object storage (voice history media). Optional for core PTT. --
# Use Cloudflare R2 / AWS S3 / MinIO. Path-style on for R2.
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ptt-voice
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=26214400

# --- Push ----------------------------------------------------------
PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=
PUSH_HIGH_PRIORITY_CHANNEL_ID=incoming-audio

# --- Rate limiting / realtime --------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=20
PTT_FLOOR_TTL_SECONDS=60

# --- Retention / seeding -------------------------------------------
DEFAULT_RETENTION_DAYS=30
SEED_DEMO_DATA=false

# --- Ops -----------------------------------------------------------
METRICS_ENABLED=true
