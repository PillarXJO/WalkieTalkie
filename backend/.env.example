# ------------------------------------------------------------------
# PTT backend — environment
# Copy to `.env` and adjust. Every value below has a safe local default
# except where marked REQUIRED-IN-PRODUCTION.
# ------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
APP_VERSION=0.1.0

# --- Data stores ---------------------------------------------------
# Local Docker Compose: postgres on :5432, redis on :6379, minio on :9000
DATABASE_URL=postgresql://ptt:ptt@localhost:5432/ptt
DATABASE_PROVIDER=postgresql
REDIS_URL=redis://localhost:6379
# SQLite quick-dev profile (skip Docker): node scripts/sync-sqlite-schema.mjs,
# then SQLITE_DATABASE_URL=file:./dev.db npx prisma generate --schema prisma/sqlite/schema.prisma
SQLITE_DATABASE_URL=file:./dev.db

# --- HTTP ----------------------------------------------------------
CORS_ORIGINS=*
ALLOW_INSECURE_CORS=true

# --- Auth (REQUIRED-IN-PRODUCTION) ---------------------------------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=4320
SCRYPT_COST=16384
TOTP_ISSUER=PTT

# --- LiveKit (WebRTC SFU) ------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_ENABLED=true

# --- Object storage (S3 / MinIO) -----------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ptt-voice
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=26214400

# --- Deep links / invites ------------------------------------------
DEEP_LINK_SCHEME=ptt
UNIVERSAL_LINK_HOST=app.ptt.example.com
WEB_BASE_URL=https://app.ptt.example.com
INVITE_BASE_URL=https://link.ptt.example.com

# --- Push ----------------------------------------------------------
PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=  # optional, only needed for Expo Push Tickets rate limits
PUSH_HIGH_PRIORITY_CHANNEL_ID=incoming-audio

# --- Rate limiting -------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=20

# --- Realtime ------------------------------------------------------
WS_MAX_PAYLOAD_BYTES=65536
PTT_FLOOR_TTL_SECONDS=60

# --- Retention / seeding -------------------------------------------
DEFAULT_RETENTION_DAYS=30
SEED_DEMO_DATA=true

# --- Ops -----------------------------------------------------------
METRICS_ENABLED=true
