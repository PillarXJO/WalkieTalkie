// ---------------------------------------------------------------------------
// PTT backend — canonical Prisma schema (PostgreSQL).
// Kept portable on purpose (no enum blocks, no @db.* native types, no arrays)
// so a SQLite development profile can be generated automatically. See:
//   scripts/sync-sqlite-schema.mjs
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Identity & authentication
// --------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  phone        String?
  locale       String    @default("en")

  // Presence (canvas state lives in Redis; the last-known values persist here)
  status        String   @default("offline") // online | busy | away | offline
  statusMessage String   @default("")
  ghostMode     Boolean  @default(false)
  lastSeenAt    DateTime?

  // TOTP 2FA
  totpSecret    String?
  totpEnabled   Boolean  @default(false)

  isBot        Boolean  @default(false) // echo bot flag
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  memberships          Membership[]
  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  sessions             Session[]
  passwordResets       PasswordReset[]
  backupCodes          BackupCode[]
  createdChannels      Channel[]           @relation("ChannelCreator")
  channelMemberships   ChannelMember[]
  transmissions        Transmission[]
  locations            LocationPing[]
  blocksSent           Block[]             @relation("Blocker")
  blocksReceived       Block[]             @relation("Blocked")
  contactsOwned        Contact[]           @relation("ContactOwner")
  contactsAdded        Contact[]           @relation("ContactTarget")
  notificationSettings NotificationSetting[] @relation("NotifOwner")
  pushTokens           PushToken[]
  audits               AuditLog[]          @relation("AuditActor")
  invitesCreated       Invite[]            @relation("InviteCreator")
  inviteUses           InviteUse[]
  emergencyAlerts      EmergencyAlert[]    @relation("AlertReporter")
  emergencyAcks        EmergencyAlert[]    @relation("AlertAck")

  @@index([deletedAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceId         String?
  deviceName       String?
  platform         String?
  osVersion        String?
  appVersion       String?
  ip               String?
  userAgent        String?
  isCurrent        Boolean   @default(true)
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Active workspace for this session (drives the `wid` claim in access tokens)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --------------------------------------------------------------------------
// Workspaces, memberships, permissions
// --------------------------------------------------------------------------

model Workspace {
  id          String   @id @default(cuid())
  name        String
  // settings/permissions/AuditLog.data are stored as serialised JSON text.
  // Kept on "String" (not Prisma's Json) so migrations are identical on
  // Postgres and SQLite — the SQLite connector emits invalid `JSONB` DDL for
  // Prisma's Json type as of v6.19.
  settings String @default("{}")
  ownerId     String?
  owner       User?    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  defaultChannelId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  members    Membership[]
  sessions   Session[]
  channels   Channel[]
  invites    Invite[]
  audits     AuditLog[]
  locations  LocationPing[]
  alerts     EmergencyAlert[]

  @@index([ownerId])
  @@index([deletedAt])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // admin | dispatcher | member
  permissions String   @default("[]")     // serialised JSON array of PERM_* overrides
  nickname    String?
  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
}

// --------------------------------------------------------------------------
// Channels
// --------------------------------------------------------------------------

model Channel {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  type         String   @default("channel") // channel | echo | broadcast
  isDefault    Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?     @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChannelMember[]
  transmissions Transmission[]

  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
}

model ChannelMember {
  id          String    @id @default(cuid())
  channelId   String
  userId      String
  role        String    @default("member") // owner | moderator | member
  permissions String    @default("[]")     // serialised JSON array of per-channel PERM_* overrides
  isMuted     Boolean   @default(false)
  mutedUntil  DateTime?
  lastReadAt  DateTime?
  joinedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

// --------------------------------------------------------------------------
// Invites
// --------------------------------------------------------------------------

model Invite {
  id           String    @id @default(cuid())
  code         String    @unique
  workspaceId  String
  createdById  String?
  role         String    @default("member")
  maxUses      Int       @default(1)
  useCount     Int       @default(0)
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator    User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  inviteUses InviteUse[]

  @@index([workspaceId])
  @@index([expiresAt])
}

model InviteUse {
  id       String   @id @default(cuid())
  inviteId String
  userId   String
  usedAt   DateTime @default(now())

  invite Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([inviteId])
  @@index([userId])
}

// --------------------------------------------------------------------------
// Voice history
// --------------------------------------------------------------------------

model Transmission {
  id          String    @id @default(cuid())
  channelId   String
  workspaceId String // denormalised for fast cross-workspace queries
  userId      String
  startedAt   DateTime  @default(now())
  durationMs  Int
  audioKey    String? // S3 object key once the recording is stored
  sizeBytes   Int?
  listeners   Int       @default(0)
  status      String    @default("complete") // live | complete | failed
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, startedAt])
  @@index([channelId, createdAt])
  @@index([workspaceId, startedAt])
  @@index([userId, startedAt])
}

// --------------------------------------------------------------------------
// Location
// --------------------------------------------------------------------------

model LocationPing {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  latitude    Float
  longitude   Float
  accuracy    Float?
  altitude    Float?
  speed       Float?
  heading     Float?
  source      String   @default("whileUsing") // always | whileUsing | manual
  at          DateTime @default(now())
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, at])
  @@index([workspaceId, at])
}

// --------------------------------------------------------------------------
// Blocks, notifications, push
// --------------------------------------------------------------------------

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Contact {
  id         String   @id @default(cuid())
  ownerId    String
  contactId  String
  nickname   String?
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  owner   User @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@index([contactId])
}

model NotificationSetting {
  id            String    @id @default(cuid())
  userId        String
  kind          String    @default("channel") // all | workspace | channel | contact | echo
  targetId      String? // channel id when kind=channel/workspace (plain FK, no relation)
  targetUserId  String? // user id when kind=contact (plain FK, no relation)
  pushEnabled   Boolean   @default(true)
  priority      String    @default("default") // default | high
  dndEnabled    Boolean   @default(false)
  dndStartMin   Int       @default(1380) // minutes since midnight (23:00)
  dndEndMin     Int       @default(420)  // minutes since midnight (07:00)
  muteUntil     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation("NotifOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@unique([userId, kind, targetUserId])
  @@index([userId])
}

model PushToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  platform   String // android | ios | web
  appId      String?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --------------------------------------------------------------------------
// Ops: audit + emergency
// --------------------------------------------------------------------------

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  data        String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model EmergencyAlert {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String
  channelId         String?
  alertType         String    @default("emergency") // emergency | panic
  status            String    @default("open") // open | acknowledged | resolved
  latitude          Float?
  longitude         Float?
  message           String?
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("AlertReporter", fields: [userId], references: [id], onDelete: Cascade)
  ackBy     User?     @relation("AlertAck", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([status])
}